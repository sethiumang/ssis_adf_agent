                <property dataType="System.String" name="OpenRowset" />
                <property dataType="System.String" name="OpenRowsetVariable" />
                <property dataType="System.String" UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor" name="SqlCommand">SELECT jh.JournalId, jl.LineNumber, jh.PostingDate, jh.JournalSource, jl.GlAccount, jl.CostCenter,
       jl.LegalEntity, jl.CurrencyCode, jl.DebitAmount, jl.CreditAmount, jl.ModifiedUtc
FROM gl.JournalHeader jh WITH (NOLOCK)
JOIN gl.JournalLine jl WITH (NOLOCK) ON jl.JournalId = jh.JournalId
WHERE jl.ModifiedUtc &gt; ? AND jl.ModifiedUtc &lt;= ? AND jh.Status = 'POSTED'</property>
