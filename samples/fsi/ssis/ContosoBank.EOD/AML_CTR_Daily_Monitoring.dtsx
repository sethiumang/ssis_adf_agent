              </inputs>
              <outputs>
                <output refId="Package\DFT Aggregate Cash Activity\CSPL CTR Threshold.Outputs[Reportable]" exclusionGroup="1" name="Reportable" synchronousInputId="Package\DFT Aggregate Cash Activity\CSPL CTR Threshold.Inputs[Conditional Split Input]">
                  <properties>
                    <property dataType="System.Int32" name="EvaluationOrder">0</property>
                    <property dataType="System.String" expressionType="Notify" name="FriendlyExpression">[TotalCashAmount] &gt; @[$Project::CtrThresholdUsd]</property>
                    <property dataType="System.String" containsID="true" name="Expression">#{Package\DFT Aggregate Cash Activity\AGG Cash Per Customer Day.Outputs[Aggregate Output 1].Columns[TotalCashAmount]} &gt; @[$Project::CtrThresholdUsd]</property>
