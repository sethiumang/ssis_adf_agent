                <output refId="Package\DFT Aggregate Cash Activity\CSPL CTR Threshold.Outputs[Near Threshold]" exclusionGroup="1" name="Near Threshold" synchronousInputId="Package\DFT Aggregate Cash Activity\CSPL CTR Threshold.Inputs[Conditional Split Input]">
