    <DTS:Executable DTS:refId="Package\FLC Wait For Core EOD" DTS:CreationName="STOCK:FORLOOP" DTS:Description="For Loop Container" DTS:DTSID="{8F2C8221-4028-5D2D-ABB9-627D692BA6C8}" DTS:ExecutableType="STOCK:FORLOOP" DTS:AssignExpression="@[User::PollAttempt] = @[User::PollAttempt] + 1" DTS:EvalExpression="@[User::EodComplete] == False &amp;&amp; @[User::PollAttempt] &lt; @[User::MaxPollAttempts]" DTS:InitExpression="@[User::PollAttempt] = 0" DTS:MaxConcurrent="1" DTS:LocaleID="-1" DTS:ObjectName="FLC Wait For Core EOD">
      <DTS:Variables />
      <DTS:Executables>
        <DTS:Executable DTS:refId="Package\FLC Wait For Core EOD\SQL Check EOD Flag" DTS:CreationName="Microsoft.ExecuteSQLTask" DTS:Description="Execute SQL Task" DTS:DTSID="{E7204ACA-1785-520F-AC69-FA140E683102}" DTS:ExecutableType="Microsoft.ExecuteSQLTask" DTS:LocaleID="-1" DTS:ObjectName="SQL Check EOD Flag" DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1" DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData SQLTask:Connection="{6B35CA2D-BA6E-56A9-A7FA-233591536ACC}" SQLTask:SqlStatementSource="SELECT CAST(CASE WHEN EXISTS (SELECT 1 FROM ops.EodStatus WHERE BusinessDate = ? AND Status = 'COMPLETE') THEN 1 ELSE 0 END AS bit) AS EodComplete;" SQLTask:ResultType="ResultSetType_SingleRow">
              <SQLTask:ResultBinding SQLTask:ResultName="EodComplete" SQLTask:DtsVariableName="User::EodComplete" />
              <SQLTask:ParameterBinding SQLTask:ParameterName="0" SQLTask:DtsVariableName="$Package::BusinessDate" SQLTask:ParameterDirection="Input" SQLTask:DataType="7" SQLTask:ParameterSize="-1" />
            </SQLTask:SqlTaskData>
          </DTS:ObjectData>
        </DTS:Executable>
