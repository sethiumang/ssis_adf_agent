            <SQLTask:SqlTaskData SQLTask:Connection="{235DCAD6-F395-56A7-BAAB-EFC1396D3A52}" SQLTask:SqlStatementSource="WAITFOR DELAY '00:01:00';" />
          </DTS:ObjectData>
        </DTS:Executable>
