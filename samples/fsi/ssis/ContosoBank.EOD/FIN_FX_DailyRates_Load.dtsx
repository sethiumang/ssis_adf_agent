    <DTS:Executable DTS:refId="Package\SQL Merge ref FxRate" DTS:CreationName="Microsoft.ExecuteSQLTask" DTS:Description="Execute SQL Task" DTS:DTSID="{3573E6C1-59F1-520B-8888-C20BAD5C485E}" DTS:ExecutableType="Microsoft.ExecuteSQLTask" DTS:LocaleID="-1" DTS:ObjectName="SQL Merge ref FxRate" DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1" DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData SQLTask:Connection="{46501A27-7F28-5459-BEF4-7CFB3B031C89}" SQLTask:SqlStatementSource="MERGE ref.FxRate AS tgt&#10;USING (SELECT CONVERT(date, RateDate, 23) AS RateDate, CurrencyCode, CAST(UnitsPerUsd AS decimal(19,8)) AS UnitsPerUsd&#10;       FROM stg.FxRate WHERE RateType = 'NOON' AND ISNUMERIC(UnitsPerUsd) = 1) AS src&#10;   ON tgt.RateDate = src.RateDate AND tgt.CurrencyCode = src.CurrencyCode&#10;WHEN MATCHED AND tgt.UnitsPerUsd &lt;&gt; src.UnitsPerUsd THEN UPDATE SET UnitsPerUsd = src.UnitsPerUsd, ModifiedUtc = SYSUTCDATETIME()&#10;WHEN NOT MATCHED THEN INSERT (RateDate, CurrencyCode, UnitsPerUsd, ModifiedUtc) VALUES (src.RateDate, src.CurrencyCode, src.UnitsPerUsd, SYSUTCDATETIME());&#10;SELECT @@ROWCOUNT AS RowsLoaded;" SQLTask:ResultType="ResultSetType_SingleRow">
          <SQLTask:ResultBinding SQLTask:ResultName="RowsLoaded" SQLTask:DtsVariableName="User::RowsLoaded" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
