                    <property dataType="System.String" UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor" name="SqlCommand">SELECT c.CustomerNumber, c.FirstName, c.LastName, c.DateOfBirth, c.TaxIdLast4, c.Email,
       c.Segment, k.RiskRating AS KycRiskRating, k.IsPep AS PepFlag, c.CountryOfResidence, c.ModifiedDate
FROM crm.Customer c
JOIN kyc.CustomerRiskProfile k ON k.CustomerNumber = c.CustomerNumber AND k.IsCurrent = 1
WHERE c.ModifiedDate &gt;= DATEADD(day, -1, ?) OR k.ReviewedDate &gt;= DATEADD(day, -1, ?)</property>
