        <DTS:Executable DTS:refId="Package\SEQ Load DimCustomer\SQL KYC Data Quality Metrics" DTS:CreationName="Microsoft.ExecuteSQLTask" DTS:Description="Execute SQL Task" DTS:DTSID="{943DFC5E-5FF8-5959-8E8F-41BC0F999139}" DTS:ExecutableType="Microsoft.ExecuteSQLTask" DTS:LocaleID="-1" DTS:ObjectName="SQL KYC Data Quality Metrics" DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1" DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData SQLTask:Connection="{DA3478ED-F3A7-5DFD-B6F7-A231C54654DC}" SQLTask:SqlStatementSource="INSERT INTO dq.MetricResult (BatchId, MetricName, MetricValue, Threshold, Passed)&#10;SELECT ?, 'DimCustomer.CurrentRowsWithoutRiskRating', COUNT(*), 0, CASE WHEN COUNT(*) = 0 THEN 1 ELSE 0 END&#10;FROM dw.DimCustomer WHERE IsCurrent = 1 AND KycRiskRating IS NULL&#10;UNION ALL&#10;SELECT ?, 'DimCustomer.DuplicateCurrentRows', COUNT(*), 0, CASE WHEN COUNT(*) = 0 THEN 1 ELSE 0 END&#10;FROM (SELECT CustomerNumber FROM dw.DimCustomer WHERE IsCurrent = 1 GROUP BY CustomerNumber HAVING COUNT(*) &gt; 1) d;">
