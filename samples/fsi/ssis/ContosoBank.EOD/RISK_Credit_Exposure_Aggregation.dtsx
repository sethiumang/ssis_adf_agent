    <DTS:Executable DTS:refId="Package\SQL Large Exposure Check" DTS:CreationName="Microsoft.ExecuteSQLTask" DTS:Description="Execute SQL Task" DTS:DTSID="{0ED3BBF8-F11A-5AE9-BFE3-98A61BCAC855}" DTS:ExecutableType="Microsoft.ExecuteSQLTask" DTS:LocaleID="-1" DTS:ObjectName="SQL Large Exposure Check" DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1" DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData SQLTask:Connection="{4774AAC6-5D1D-5C5E-B79F-207B805BAEA7}" SQLTask:SqlStatementSource="SELECT COUNT(*) AS LargeExposureCount FROM risk.CounterpartyExposure ce&#10;JOIN [RISKSQL01].[RiskMart].[ref].[Tier1Capital] t ON t.AsOfDate = EOMONTH(ce.AsOfDate, -1)&#10;WHERE ce.AsOfDate = ? GROUP BY ce.CounterpartyId, t.Tier1CapitalUsd HAVING SUM(ce.TotalEadUsd) &gt; 0.10 * t.Tier1CapitalUsd;" SQLTask:ResultType="ResultSetType_SingleRow">
          <SQLTask:ResultBinding SQLTask:ResultName="LargeExposureCount" SQLTask:DtsVariableName="User::LargeExposureCount" />
          <SQLTask:ParameterBinding SQLTask:ParameterName="0" SQLTask:DtsVariableName="$Package::BusinessDate" SQLTask:ParameterDirection="Input" SQLTask:DataType="7" SQLTask:ParameterSize="-1" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable DTS:refId="Package\SQL Publish FR Y-14Q Extract" DTS:CreationName="Microsoft.ExecuteSQLTask" DTS:Description="Cross-server INSERT via linked server to regulatory reporting staging" DTS:DTSID="{960FEB4D-908A-5519-9B99-059DD2202DFA}" DTS:ExecutableType="Microsoft.ExecuteSQLTask" DTS:LocaleID="-1" DTS:ObjectName="SQL Publish FR Y-14Q Extract" DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1" DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData SQLTask:Connection="{4774AAC6-5D1D-5C5E-B79F-207B805BAEA7}" SQLTask:SqlStatementSource="INSERT INTO [REGRPTSQL01].[RegReporting].[y14q].[CorporateLoanStage] (AsOfDate, ObligorId, FacilityId, CommittedExposureUsd, UtilizedExposureUsd, Pd, Lgd)&#10;SELECT s.AsOfDate, s.CounterpartyId, s.FacilityId, (s.OutstandingAmt + s.UndrawnAmt) / f.UnitsPerUsd, s.OutstandingAmt / f.UnitsPerUsd, s.Pd, s.Lgd&#10;FROM risk.ExposureStage s JOIN FinanceDW.ref.FxRate f ON f.CurrencyCode = s.CurrencyCode AND f.RateDate = s.AsOfDate&#10;WHERE s.Portfolio = 'COMMERCIAL' AND (s.OutstandingAmt + s.UndrawnAmt) &gt;= 1000000;" />
      </DTS:ObjectData>
    </DTS:Executable>
