            <component refId="Package\DFT Aggregate Exposures\OLE SRC Mortgages (Four-Part Name)" componentClassID="Microsoft.OLEDBSource" description="OLE DB Source" name="OLE SRC Mortgages (Four-Part Name)" version="7" usesDispositions="true">
              <properties>
                <property dataType="System.Int32" name="CommandTimeout">0</property>
                <property dataType="System.String" name="OpenRowset" />
                <property dataType="System.String" name="OpenRowsetVariable" />
                <property dataType="System.String" UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor" name="SqlCommand">SELECT b.BorrowerId AS CounterpartyId, 'MORTGAGE' AS Portfolio, l.LoanNumber AS FacilityId, 'USD' AS CurrencyCode,
       l.UnpaidPrincipal AS OutstandingAmt, CAST(0 AS decimal(19,4)) AS UndrawnAmt, r.Pd, r.Lgd
FROM [MORTGAGESRV].[Mortgage].[dbo].[LoanBalance] l
JOIN [MORTGAGESRV].[Mortgage].[dbo].[Borrower] b ON b.LoanNumber = l.LoanNumber AND b.IsPrimary = 1
JOIN RiskMart.risk.RetailPdLgd r ON r.ProductCode = l.ProductCode AND r.Bucket = l.DelinquencyBucket
WHERE l.AsOfDate = ?</property>
                <property dataType="System.String" name="SqlCommandVariable" />
                <property dataType="System.Int32" name="DefaultCodePage">1252</property>
                <property dataType="System.Boolean" name="AlwaysUseDefaultCodePage">false</property>
