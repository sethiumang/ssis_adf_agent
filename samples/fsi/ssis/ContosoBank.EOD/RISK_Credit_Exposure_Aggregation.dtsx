                <property dataType="System.String" UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor" name="SqlCommand">SELECT a.CustomerId AS CounterpartyId, 'CARD' AS Portfolio, a.CardAccountId AS FacilityId, a.CurrencyCode,
       a.CurrentBalance AS OutstandingAmt, a.CreditLimit - a.CurrentBalance AS UndrawnAmt, s.Pd, s.Lgd
FROM CardPlatform.dbo.Account a
JOIN CardScoring.dbo.AccountScore s ON s.CardAccountId = a.CardAccountId AND s.ScoreDate = ?
WHERE a.Status IN ('OPEN','DELINQ')</property>
