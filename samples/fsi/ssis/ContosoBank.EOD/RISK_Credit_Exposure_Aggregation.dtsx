                <property dataType="System.String" UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor" name="SqlCommand">SELECT CounterpartyId, 'COMMERCIAL' AS Portfolio, FacilityId, CurrencyCode, OutstandingAmt, UndrawnAmt, Pd, Lgd
FROM OPENQUERY([LOANSRV], 'SELECT cp_id AS CounterpartyId, facility_no AS FacilityId, ccy AS CurrencyCode,
  outstanding AS OutstandingAmt, undrawn AS UndrawnAmt, pd_1y AS Pd, lgd_dt AS Lgd
  FROM cl.facility_balance WHERE status &lt;&gt; ''CLOSED''')</property>
