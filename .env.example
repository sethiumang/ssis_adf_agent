# Copy to .env and fill in only what you need. .env is git-ignored; never commit real values.
# VS Code's MCP server does not read this file automatically. Either set these values in your shell
# before starting VS Code, or add them to the "env" block in .vscode/mcp.json on your machine.

# --- Deployment with a service principal (CI/CD). Not needed if you use `az login`. ---
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# --- Target Data Factory (passed to the deploy_to_adf tool / deploy prompt) ---
ADF_SUBSCRIPTION_ID=
ADF_RESOURCE_GROUP=
ADF_FACTORY_NAME=

# --- Optional: LLM translation of Script Tasks (convert with llm_translate=true) ---
# Sends C# Script Task source to YOUR Azure OpenAI deployment.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o
